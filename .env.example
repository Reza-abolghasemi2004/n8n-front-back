# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+psycopg://agent_platform:CHANGE_ME@postgres:5432/agent_platform

# ------------------------------------------------------------------------------
# Flask Application Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME
SESSION_COOKIE_SECURE=true

# Optional: Initial Admin Bootstrap (used by `flask create-admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# n8n Integration Configuration
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=CHANGE_ME
N8N_WEBHOOK_PATH=/webhook/project-intake
N8N_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n:5678/
